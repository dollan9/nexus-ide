# =====================================================================
# NEXUS-IDE — mall för ALLA nycklar och inställningar.
# Kopiera till .env och fyll i. ALDRIG commita .env. Aldrig hårdkoda nycklar.
# Every value below is read by the app at runtime; empty = the feature
# degrades gracefully (never crashes).
# =====================================================================

# --- Molnprovider (OpenAI-kompatibla eller egna SDK) -------------------
# NVIDIA NIM — nyckel skapas på https://build.nvidia.com/settings/api-keys
# Utan nyckel:modellkatalogen hämtas ändå publikt, men chat/endast kräver nyckel.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Valfri custom endpoint (användaren klistrar in i UI) --------------
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Lokala inferensservrar --------------------------------------------
# RESURSBUDGET (AGENTS.md Regel 7, infördes efter systemkrasch 2026-10-15):
# max EN laddad modell och EN parallell körning. qwen3:14b (9,28 GB) är förbjuden på 10 GB VRAM.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=120
OLLAMA_BASE_URL=http://127.0.0.1:11434
VLLM_BASE_URL=http://127.0.0.1:8000/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# --- Roll-fördelning (en modell per uppgift) ---------------------------
CHAT_MODEL=qwen2.5-coder:1.5b
AUTOCOMPLETE_MODEL=qwen2.5-coder:1.5b
EMBEDDINGS_MODEL=all-minilm
# VISION_MODEL: qwen3-vl:4b-instruct ryms bara om inget annat körs — P1, laddas ALDRIG under P0-bygge
VISION_MODEL=
REASONING_MODEL=

# --- Python AI-service (öron + ögon) ----------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=7955
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=sv
TTS_ENGINE=piper
PIPER_VOICE=en_US-lessac-medium
OCR_ENGINE=rapidocr

# --- Agent & säkerhet --------------------------------------------------
AGENT_APPROVAL_MODE=ask        # ask | allowlist | auto
AGENT_ALLOWLIST=ls,cat,echo,pwd,git status,pnpm test,node --version
AGENT_MAX_STEPS=24
NEXUS_ROOT=./.nexus
LOG_LEVEL=debug

# --- MCP ---------------------------------------------------------------
MCP_CONFIG_PATH=./mcp.json

# --- Övrigt ------------------------------------------------------------
BRAVE_API_KEY=
